# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testes
/test-results/
/playwright-report/
/blob-report/

# credenciais e segredos
*.key
*.p12
*.pfx
credentials*.json
service-account*.json
*secret*.json
.npmrc

# supabase cli (arquivos locais/temporários)
/supabase/.temp/
/supabase/.branches/

# configurações locais de ferramentas
.claude/settings.local.json
